---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
---

<Layout>
  <h1 class="text-4xl font-bold text-center my-5">
    Opciones de header y Footer
  </h1>
  <h2 class="text-3xl font-medium mb-2">Opciones de Header:</h2>
  <div>
    <h3 class="text-2xl font-medium">Header 1:</h3>
    <Header varianthHeader="one" />
    <div class="h-5"></div>
  </div>
  <div>
    <h3 class="text-2xl font-medium">Header 2:</h3>
    <Header varianthHeader="two" />
    <div class="h-5"></div>
  </div>
  <div>
    <h3 class="text-2xl font-medium">Header 3:</h3>
    <Header varianthHeader="three" />
    <div class="h-5"></div>
  </div>
  <div>
    <h3 class="text-2xl font-medium">Header 3:</h3>
    <Header varianthHeader="four" />
    <div class="h-5"></div>
  </div>
  <Hero />
</Layout>
