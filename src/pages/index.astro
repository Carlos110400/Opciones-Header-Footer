---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
---

<Layout>
  <h1 class="text-4xl font-bold text-center my-5 container mx-auto">
    Opciones de header y Footer
  </h1>
  <h2
    class="text-3xl font-medium mb-5 container mx-auto underline underline-offset-4"
  >
    Opciones de Header:
  </h2>
  <h3 class="text-2xl font-medium container mx-auto">Header 1:</h3>
  <Header varianthHeader="one" />
  <div class="h-5 border-b-4 border-dashed border-gray-300 pb-10 mb-8"></div>
</Layout>
<div>
  <h3 class="text-2xl font-medium container mx-auto">Header 2:</h3>
  <Header varianthHeader="two" />
  <div class="h-5 border-b-4 border-dashed border-gray-300 pb-10 mb-8"></div>
</div>
<div>
  <h3 class="text-2xl font-medium container mx-auto">Header 3:</h3>
  <Header varianthHeader="three" />
  <div class="h-5 border-b-4 border-dashed border-gray-300 pb-10 mb-8"></div>
</div>
<div>
  <h3 class="text-2xl font-medium container mx-auto">Header 3:</h3>
  <Header varianthHeader="four" />
  <div class="h-5 border-b-4 border-dashed border-gray-300 pb-10 mb-8"></div>
</div>
<Hero />
